{
  "port": 9001,
  "instanceName": "default",
  "basePath": "",

  "health": {
    "enabled": true,
    "url": "http://127.0.0.1:18789/health",
    "intervalMs": 5000,
    "timeoutMs": 5000,
    "failThreshold": 3
  },

  "cron": {
    "enabled": true,
    "url": "http://127.0.0.1:18789/cron",
    "intervalMs": 5000,
    "timeoutMs": 5000
  },

  "ping": {
    "enabled": true,
    "targets": [
      { "name": "Google", "url": "https://www.google.com" },
      { "name": "Baidu", "url": "https://www.baidu.com" }
    ],
    "timeoutMs": 10000
  },

  "codexUsage": {
    "enabled": true,
    "intervalMs": 300000,
    "authProfilesPath": "~/.openclaw/agents/main/agent/auth-profiles.json"
  },

  "sub2apiUsage": {
    "enabled": false,
    "monitorBaseUrl": "https://monitor.example.com",
    "username": "",
    "apiToken": "",
    "intervalMs": 30000,
    "cacheTtlMs": 30000,
    "timeoutMs": 8000,
    "staleTtlMs": 300000,
    "allowLocalRefresh": false
  },

  "logs": {
    "maxEntries": 500,
    "sources": [
      { "name": "gateway", "path": "~/.openclaw/logs/gateway.log" },
      { "name": "errors", "path": "~/.openclaw/logs/gateway.err.log" }
    ]
  },

  "deploy": {
    "staticDir": "./data/static"
  },

  "wecomArchiveRelay": {
    "_注": "启用方式:把 enabled 改 true,sharedSecret 填后台 BfeClawInstance.openclawWebhookSecret 同一值;pluginUrl/timeoutMs/ringSize 不写则用 panel 内置默认(http://127.0.0.1:18789/plugins/wecom-archive/ingest / 7000ms / 100 条)",
    "enabled": false,
    "sharedSecret": ""
  },

  "feishuStatus": {
    "enabled": true,
    "gatewayUrl": "ws://localhost:18789",
    "gatewayToken": "",
    "activeMinutes": 240,
    "limit": 200,
    "refreshIntervalMs": 5000,
    "staleMs": 180000,
    "idleMs": 1800000,
    "onlyFeishu": true
  },

  "frpc": {
    "version": "0.61.1",
    "serverAddr": "claw.bfelab.com",
    "serverPort": 7000,
    "loginFailExit": false,
    "transport": {
      "heartbeatInterval": 10,
      "heartbeatTimeout": 30,
      "protocol": "tcp"
    },
    "proxies": [
      {
        "name": "monitor-v2",
        "type": "http",
        "localIP": "127.0.0.1",
        "localPort": 9001,
        "customDomains": ["claw.bfelab.com"],
        "locations": ["/default"]
      }
    ]
  },

  "authGateway": {
    "port": 4180,
    "sessionTtlMs": 604800000,
    "cookieName": "claw_session",
    "authProvider": "password",
    "provider": {
      "password": "changeme"
    },
    "tenants": {}
  }
}
